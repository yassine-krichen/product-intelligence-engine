# Postgres connection string. In production this points at a Neon-managed
# database — see README.md for setup. No local Postgres is assumed for
# development in this environment.
DATABASE_URL="postgresql://user:password@localhost:5432/product_intelligence_engine?schema=public"

# Redis connection string, used by BullMQ for the research-run job queue.
# Local dev default assumes a local Redis Windows service on the standard
# port. Upstash's REDIS_URL (rediss://... with TLS) works identically here
# in production — ioredis speaks both protocols transparently.
REDIS_URL="redis://127.0.0.1:6379"

# Descriptive User-Agent sent to Reddit's public JSON endpoints. Reddit asks
# API consumers to identify themselves; keep this specific to this project.
REDDIT_USER_AGENT="product-intelligence-engine/0.1 (by u/your-reddit-username)"
